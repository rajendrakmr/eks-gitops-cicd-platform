# Copy to .env (or run `make init`, which generates strong secrets for you).
# NEVER commit the real .env.

# Shared by gateway + auth-service. Use a long random string (openssl rand -hex 32).
JWT_SECRET=change-me
POSTGRES_PASSWORD=change-me

# Seeded admin account (created on first start). Change the password before exposing the stack.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

HTTP_PORT=80
CURRENCY=USD
GRAFANA_PASSWORD=admin
